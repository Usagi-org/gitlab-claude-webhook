# 环境变量配置
# 支持变量替换: ${VAR} 或 $VAR 语法

# Claude API配置
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_AUTH_TOKEN=sk-your-anthropic-token

# GitLab配置
GITLAB_BASE_URL=https://gitlab.com
GITLAB_TOKEN=glpat-your-gitlab-token

# Webhook配置
WEBHOOK_SECRET=your-webhook-secret
PORT=3000

# 工作目录配置
WORK_DIR=/tmp/gitlab-claude-work

# 日志配置
LOG_LEVEL=info

# Claude系统提示词（可选）
# 可以在这里添加额外的系统提示词，这些提示词将被追加到默认的系统提示词后面
# 推荐配置：优化 GitLab Markdown 渲染兼容性
CLAUDE_SYSTEM_PROMPT=When providing responses that will be posted to GitLab, follow these formatting rules strictly:\n1. Use proper GitLab-flavored Markdown syntax\n2. For code blocks, ALWAYS specify the language identifier after the opening backticks (e.g., ```java, ```python, ```bash)\n3. Ensure there is a blank line before and after each code block\n4. Use proper heading hierarchy (# for h1, ## for h2, etc.)\n5. For inline code, use single backticks: `code`\n6. For lists, ensure proper spacing and indentation\n7. Avoid using HTML tags unless absolutely necessary\n8. Test that all Markdown syntax is GitLab-compatible
